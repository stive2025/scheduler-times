# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=sefil_asistencias
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://your_db_user_here:your_db_password_here@localhost:5432/sefil_asistencias

# ── Biometric Device ─────────────────────────────────────
BIOMETRIC_URL=http://your_biometric_ip_here
BIOMETRIC_USER=your_biometric_user_here
BIOMETRIC_PASSWORD=your_biometric_password_here

# ── pgAdmin (optional) ───────────────────────────────────
PGADMIN_DEFAULT_EMAIL=your_email_here
PGADMIN_DEFAULT_PASSWORD=your_password_here
